    {
      "name": "08 - Invalid config is accepted at registration but the route never comes up",
      "item": [
        {
          "name": "missing guardName is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: gr2-invalid-missing-guardname\nspec:\n  displayName: gr2-invalid-missing-guardname\n  version: v1.0\n  context: /gr2-invalid-missing-guardname\n  provider:\n    id: guardrails-ai-e2e-provider\n  policies:\n    - name: guardrails-ai\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            guardrailsApiEndpoint: \"http://host.docker.internal:9730\"\n            request:\n              enabled: true\n"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration itself succeeds (system-param default fails later, at route-build time)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "missing guardrailsApiEndpoint is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: gr2-invalid-missing-endpoint\nspec:\n  displayName: gr2-invalid-missing-endpoint\n  version: v1.0\n  context: /gr2-invalid-missing-endpoint\n  provider:\n    id: guardrails-ai-e2e-provider\n  policies:\n    - name: guardrails-ai\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            guardName: test-guard\n            request:\n              enabled: true\n"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration itself succeeds (system-param default fails later, at route-build time)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "gr2-invalid-missing-guardname route never comes up (policy chain failed to build)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/gr2-invalid-missing-guardname/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "gr2-invalid-missing-guardname",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"messages\": [{\"role\": \"user\", \"content\": \"BLOCK_ME please\"}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A policy instance that fails to build (missing/invalid required param) is",
                  "// dropped by the gateway-runtime, which logs \"Failed to build policy chain",
                  "// for route, skipping\" and then serves the route WITHOUT the guardrail",
                  "// (fail-open) - it does NOT take the route down. Operators must monitor that",
                  "// log line to detect a guardrail that silently stopped enforcing. This test",
                  "// pins the observable contract: the route stays reachable but the guardrail",
                  "// is provably not enforcing (a BLOCK_ME payload is NOT turned into a 422).",
                  "pm.test('misconfigured route: guardrail is not enforced (policy dropped, see runtime log)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 404, 500]);",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect(pm.response.text()).to.not.include('GUARDRAILS_AI_GUARDRAIL');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "gr2-invalid-missing-endpoint route never comes up (policy chain failed to build)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/gr2-invalid-missing-endpoint/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "gr2-invalid-missing-endpoint",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"messages\": [{\"role\": \"user\", \"content\": \"BLOCK_ME please\"}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A policy instance that fails to build (missing/invalid required param) is",
                  "// dropped by the gateway-runtime, which logs \"Failed to build policy chain",
                  "// for route, skipping\" and then serves the route WITHOUT the guardrail",
                  "// (fail-open) - it does NOT take the route down. Operators must monitor that",
                  "// log line to detect a guardrail that silently stopped enforcing. This test",
                  "// pins the observable contract: the route stays reachable but the guardrail",
                  "// is provably not enforcing (a BLOCK_ME payload is NOT turned into a 422).",
                  "pm.test('misconfigured route: guardrail is not enforced (policy dropped, see runtime log)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 404, 500]);",
                  "  if (pm.response.code === 200) {",
                  "    pm.expect(pm.response.text()).to.not.include('GUARDRAILS_AI_GUARDRAIL');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
