    {
      "name": "01 - Register",
      "item": [
        {
          "name": "Register LlmProvider (echo backend)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-providers",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-providers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProvider\nmetadata:\n  name: guardrails-ai-e2e-provider\nspec:\n  displayName: Guardrails AI E2E Echo Provider\n  version: v1.0\n  template: openai\n  upstream:\n    url: http://host.docker.internal:9731\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "response": []
        },
        {
          "name": "Register LlmProxy gr2-main",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: gr2-main\nspec:\n  displayName: gr2-main\n  version: v1.0\n  context: /gr2-main\n  provider:\n    id: guardrails-ai-e2e-provider\n  policies:\n    - name: guardrails-ai\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            guardrailsApiEndpoint: \"http://host.docker.internal:9730\"\n            apiKey: \"test-secret-key\"\n            guardName: test-guard\n            request:\n              enabled: true\n              passthroughOnError: false\n              showAssessment: true\n            response:\n              enabled: true\n              passthroughOnError: true\n              showAssessment: false\n"
            }
          },
          "response": []
        },
        {
          "name": "Register LlmProxy gr2-response-only",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: gr2-response-only\nspec:\n  displayName: gr2-response-only\n  version: v1.0\n  context: /gr2-response-only\n  provider:\n    id: guardrails-ai-e2e-provider\n  policies:\n    - name: guardrails-ai\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            guardrailsApiEndpoint: \"http://host.docker.internal:9730\"\n            guardName: test-guard\n            request:\n              enabled: false\n            response:\n              enabled: true\n              passthroughOnError: false\n              showAssessment: false\n"
            }
          },
          "response": []
        },
        {
          "name": "Register LlmProxy gr2-size-block",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: gr2-size-block\nspec:\n  displayName: gr2-size-block\n  version: v1.0\n  context: /gr2-size-block\n  provider:\n    id: guardrails-ai-e2e-provider\n  policies:\n    - name: guardrails-ai\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            guardrailsApiEndpoint: \"http://host.docker.internal:9730\"\n            guardName: test-guard\n            maxResponseBytes: 64\n            request:\n              enabled: true\n              passthroughOnError: false\n"
            }
          },
          "response": []
        },
        {
          "name": "Register LlmProxy gr2-size-passthrough",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: gr2-size-passthrough\nspec:\n  displayName: gr2-size-passthrough\n  version: v1.0\n  context: /gr2-size-passthrough\n  provider:\n    id: guardrails-ai-e2e-provider\n  policies:\n    - name: guardrails-ai\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            guardrailsApiEndpoint: \"http://host.docker.internal:9730\"\n            guardName: test-guard\n            maxResponseBytes: 64\n            request:\n              enabled: true\n              passthroughOnError: true\n"
            }
          },
          "response": []
        },
        {
          "name": "Register LlmProxy gr2-timeout-block",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: gr2-timeout-block\nspec:\n  displayName: gr2-timeout-block\n  version: v1.0\n  context: /gr2-timeout-block\n  provider:\n    id: guardrails-ai-e2e-provider\n  policies:\n    - name: guardrails-ai\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            guardrailsApiEndpoint: \"http://host.docker.internal:9730\"\n            guardName: test-guard\n            requestTimeout: 1\n            request:\n              enabled: true\n              passthroughOnError: false\n"
            }
          },
          "response": []
        },
        {
          "name": "Register LlmProxy gr2-timeout-passthrough",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: gr2-timeout-passthrough\nspec:\n  displayName: gr2-timeout-passthrough\n  version: v1.0\n  context: /gr2-timeout-passthrough\n  provider:\n    id: guardrails-ai-e2e-provider\n  policies:\n    - name: guardrails-ai\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            guardrailsApiEndpoint: \"http://host.docker.internal:9730\"\n            guardName: test-guard\n            requestTimeout: 1\n            request:\n              enabled: true\n              passthroughOnError: true\n"
            }
          },
          "response": []
        },
        {
          "name": "Register LlmProxy gr2-custom-jsonpath",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: gr2-custom-jsonpath\nspec:\n  displayName: gr2-custom-jsonpath\n  version: v1.0\n  context: /gr2-custom-jsonpath\n  provider:\n    id: guardrails-ai-e2e-provider\n  policies:\n    - name: guardrails-ai\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            guardrailsApiEndpoint: \"http://host.docker.internal:9730\"\n            guardName: test-guard\n            request:\n              enabled: true\n              jsonPath: \"$.prompt\"\n              passthroughOnError: false\n"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Request phase: pass-through",
      "item": [
        {
          "name": "reset mocks",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://{{guardrailsMockUrl}}/debug/reset",
              "protocol": "http",
              "host": [
                "{{guardrailsMockUrl}}"
              ],
              "path": [
                "debug",
                "reset"
              ]
            }
          },
          "response": []
        },
        {
          "name": "benign message allowed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/gr2-main/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "gr2-main",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"mock-model\", \"messages\": [{\"role\": \"user\", \"content\": \"hello there, nothing wrong here\"}]}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "guardrails server received extracted text",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{guardrailsMockUrl}}/debug/last-request",
              "protocol": "http",
              "host": [
                "{{guardrailsMockUrl}}"
              ],
              "path": [
                "debug",
                "last-request"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('llmOutput matches last user message', () => pm.expect(j.llmOutput).to.eql('hello there, nothing wrong here'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Request phase: block + showAssessment",
      "item": [
        {
          "name": "blocked message returns 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/gr2-main/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "gr2-main",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"mock-model\", \"messages\": [{\"role\": \"user\", \"content\": \"this contains BLOCK_ME keyword\"}]}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "const j = pm.response.json();",
                  "pm.test('type is GUARDRAILS_AI_GUARDRAIL', () => pm.expect(j.type).to.eql('GUARDRAILS_AI_GUARDRAIL'));",
                  "pm.test('direction is REQUEST', () => pm.expect(j.message.direction).to.eql('REQUEST'));",
                  "pm.test('showAssessment=true includes failedValidators', () => pm.expect(j.message.assessments.failedValidators).to.include('ToxicLanguage'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Response phase: pass-through and block",
      "item": [
        {
          "name": "reset mocks",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://{{guardrailsMockUrl}}/debug/reset",
              "protocol": "http",
              "host": [
                "{{guardrailsMockUrl}}"
              ],
              "path": [
                "debug",
                "reset"
              ]
            }
          },
          "response": []
        },
        {
          "name": "benign reply allowed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/gr2-response-only/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "gr2-response-only",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"mock-model\", \"messages\": [{\"role\": \"user\", \"content\": \"say something totally fine\"}]}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "reply containing BLOCK_ME is blocked",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/gr2-response-only/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "gr2-response-only",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"mock-model\", \"messages\": [{\"role\": \"user\", \"content\": \"please reply with BLOCK_ME in your answer\"}]}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422', () => pm.response.to.have.status(422));",
                  "const j = pm.response.json();",
                  "pm.test('direction is RESPONSE', () => pm.expect(j.message.direction).to.eql('RESPONSE'));",
                  "pm.test('showAssessment=false omits assessments', () => pm.expect(j.message.assessments).to.be.undefined);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Guardrails response exceeds maxResponseBytes",
      "item": [
        {
          "name": "blocked when passthroughOnError=false",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/gr2-size-block/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "gr2-size-block",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"mock-model\", \"messages\": [{\"role\": \"user\", \"content\": \"trigger HUGE_RESPONSE from the guard\"}]}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 422 (treated as error)', () => pm.response.to.have.status(422));",
                  "const j = pm.response.json();",
                  "pm.test('sterile reason, no internal detail leaked', () => {",
                  "  pm.expect(j.message.actionReason).to.not.include('byte limit');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "passthrough when passthroughOnError=true",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/gr2-size-passthrough/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "gr2-size-passthrough",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"mock-model\", \"messages\": [{\"role\": \"user\", \"content\": \"trigger HUGE_RESPONSE from the guard\"}]}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 (passed through)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
