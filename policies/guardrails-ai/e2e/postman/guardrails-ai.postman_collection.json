                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"mock-model\", \"messages\": [{\"role\": \"user\", \"content\": \"trigger SLOW_RESPONSE please\"}]}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
