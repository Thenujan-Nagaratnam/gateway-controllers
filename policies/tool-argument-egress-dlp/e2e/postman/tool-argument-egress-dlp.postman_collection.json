    {
      "name": "06 - Redact rewrites the offending arg",
      "item": [
        {
          "name": "reset mock",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://{{mockUrl}}/debug/reset",
              "protocol": "http",
              "host": [
                "{{mockUrl}}"
              ],
              "path": [
                "debug",
                "reset"
              ]
            }
          }
        },
        {
          "name": "dsn via dlp-redact -> 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/dlp-redact/call",
              "protocol": "https",
