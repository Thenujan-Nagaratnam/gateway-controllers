      "name": "03 - AWS key in a tool arg is blocked",
      "item": [
        {
          "name": "aws key -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/dlp-block/call",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "dlp-block",
                "call"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"call_partner_api\", \"arguments\": {\"note\": \"bucket creds AKIAIOSFODNN7EXAMPLE\"}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422',()=>pm.response.to.have.status(422));",
                  "const j=pm.response.json();",
                  "pm.test('type',()=>pm.expect(j.type).to.eql('TOOL_ARGUMENT_EGRESS_DLP'));",
                  "pm.test('direction REQUEST',()=>pm.expect(j.message.direction).to.eql('REQUEST'));",
                  "pm.test('assessments present',()=>pm.expect(j.message.assessments).to.be.an('array').that.is.not.empty);",
                  "pm.test('raw secret NOT echoed',()=>pm.expect(pm.response.text()).to.not.include('AKIAIOSFODNN7EXAMPLE'));"
                ]
              }
            }
          ]
        }
      ]
    },
