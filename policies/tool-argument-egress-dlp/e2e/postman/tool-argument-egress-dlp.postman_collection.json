              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200',()=>pm.response.to.have.status(200));",
                  "pm.test('reached backend',()=>pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
