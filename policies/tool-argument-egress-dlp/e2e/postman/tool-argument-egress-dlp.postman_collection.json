            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"call_partner_api\", \"arguments\": {\"query\": \"weather in Paris\", \"limit\": 5}}}"
            }
