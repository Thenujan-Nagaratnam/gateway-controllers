    {
      "name": "10 - Invalid config accepted at registration but the route never enforces",
      "item": [
        {
          "name": "register dlp-invalid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: dlp-invalid\nspec:\n  displayName: dlp-invalid\n  version: v1.0\n  context: /dlp-invalid\n  provider:\n    id: dlp-e2e-provider\n  policies:\n    - name: tool-argument-egress-dlp\n      version: v0\n      paths:\n        - path: /call\n          methods: [POST]\n          params:\n            detectors:\n              secrets:\n                enabled: false\n              pii:\n                enabled: false\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration succeeds',()=>pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "dlp-invalid route does not enforce",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/dlp-invalid/call",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "dlp-invalid",
                "call"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"call_partner_api\", \"arguments\": {\"note\": \"creds AKIAIOSFODNN7EXAMPLE\"}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('misconfigured route: dlp not enforced',()=>{",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404,500]);",
                  "  if (pm.response.code===200) pm.expect(pm.response.text()).to.not.include('TOOL_ARGUMENT_EGRESS_DLP');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
