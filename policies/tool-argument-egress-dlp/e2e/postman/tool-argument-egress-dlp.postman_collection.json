              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"call_partner_api\", \"arguments\": {\"db\": \"postgres://admin:s3cr3tP@db.internal:5432/prod\", \"keep\": \"value\"}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('redacted, forwarded',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "backend received redacted arg",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{mockUrl}}/debug/last-request",
              "protocol": "http",
              "host": [
                "{{mockUrl}}"
              ],
              "path": [
                "debug",
                "last-request"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const seen=pm.response.json();",
                  "const args=JSON.parse(seen.body).params.arguments;",
                  "pm.test('secret redacted before forwarding',()=>pm.expect(args.db).to.not.include('s3cr3tP'));",
                  "pm.test('other arg intact',()=>pm.expect(args.keep).to.eql('value'));",
                  "pm.test('x-egress-dlp-action reached backend',()=>pm.expect(seen.headers['x-egress-dlp-action']).to.eql('redacted'));"
                ]
              }
            }
          ]
        }
      ]
    },
