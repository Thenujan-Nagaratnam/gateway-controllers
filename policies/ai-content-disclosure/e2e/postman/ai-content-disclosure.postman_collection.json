                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();",
                  "pm.test('content unchanged',()=>pm.expect(j.choices[0].message.content).to.eql('hi'));",
                  "pm.test('no header',()=>pm.expect(pm.response.headers.has('x-ai-generated')).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "long reply -> disclosed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/disclosure-min-chars/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "disclosure-min-chars",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"gpt-4o\", \"messages\": [{\"role\": \"user\", \"content\": \"this reply is definitely long enough\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();",
                  "pm.test('notice appended',()=>pm.expect(j.choices[0].message.content).to.include('AI NOTICE'));"
                ]
              }
            }
          ]
        }
      ]
    },
