            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();",
                  "const content=j.choices[0].message.content;",
                  "pm.test('longer than the original (invisible chars added)',()=>pm.expect(content.length).to.be.above('plain reply'.length));",
                  "const stripped=content.replace(/[\\u2060\\u200B\\u200C]/g,'');",
                  "pm.test('visible text unchanged once zero-width chars are stripped',()=>pm.expect(stripped).to.eql('plain reply'));",
                  "const delimiters=(content.match(/\\u2060/g)||[]).length;",
                  "pm.test('exactly two WORD JOINER delimiters (start+end)',()=>pm.expect(delimiters).to.eql(2));"
                ]
              }
            }
          ]
        }
      ]
    },
