    {
      "name": "02 - Default placement (append) adds a visible notice and headers",
      "item": [
        {
          "name": "call -> 200, notice appended, headers set",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/disclosure-append/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "disclosure-append",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"gpt-4o\", \"messages\": [{\"role\": \"user\", \"content\": \"hello world\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "const content=j.choices[0].message.content;",
                  "pm.test('original reply preserved at the start',()=>pm.expect(content.startsWith('hello world')).to.eql(true));",
                  "pm.test('notice appended',()=>pm.expect(content.endsWith('This content was generated by an AI system.')).to.eql(true));",
                  "pm.test('x-ai-generated header',()=>pm.expect(pm.response.headers.get('x-ai-generated')).to.eql('true'));",
                  "pm.test('x-ai-disclosure-standard header',()=>pm.expect(pm.response.headers.get('x-ai-disclosure-standard')).to.eql('eu-ai-act-art50'));"
                ]
              }
            }
          ]
        },
        {
          "name": "a reply that already carries the notice is not disclosed twice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/disclosure-append/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "disclosure-append",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"gpt-4o\", \"messages\": [{\"role\": \"user\", \"content\": \"already disclosed reply\\n\\nThis content was generated by an AI system.\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();",
                  "const content=j.choices[0].message.content;",
                  "const count=(content.match(/This content was generated by an AI system\\./g)||[]).length;",
                  "pm.test('notice appears exactly once, not duplicated',()=>pm.expect(count).to.eql(1));"
                ]
              }
            }
          ]
        }
      ]
    },
