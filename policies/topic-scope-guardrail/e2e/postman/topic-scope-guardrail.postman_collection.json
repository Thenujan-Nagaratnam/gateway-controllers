            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('misconfigured route: scope not enforced',()=>{",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404,500]);",
                  "  if (pm.response.code===200) pm.expect(pm.response.text()).to.not.include('TOPIC_SCOPE_GUARDRAIL');",
                  "});"
                ]
              }
            }
          ]
        }
