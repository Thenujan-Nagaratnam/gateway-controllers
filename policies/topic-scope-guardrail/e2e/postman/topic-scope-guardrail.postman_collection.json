              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 (annotate never blocks)',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "backend saw x-topic-scope: off-topic",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{mockUrl}}/debug/last-request",
              "protocol": "http",
              "host": [
                "{{mockUrl}}"
              ],
              "path": [
                "debug",
                "last-request"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
