                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 - checkResponse blocks a reply that drifts off-topic",
      "item": [
        {
          "name": "short DRIFT-triggering message -> request-phase skipped, reply blocked",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/scope-response-check/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "scope-response-check",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"gpt-4o\", \"messages\": [{\"role\": \"user\", \"content\": \"DRIFT\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422',()=>pm.response.to.have.status(422));",
                  "const j=pm.response.json();",
                  "pm.test('direction RESPONSE',()=>pm.expect(j.message.direction).to.eql('RESPONSE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "in-scope reply -> 200 passes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/scope-response-check/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "scope-response-check",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"gpt-4o\", \"messages\": [{\"role\": \"user\", \"content\": \"What's my account balance?\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
