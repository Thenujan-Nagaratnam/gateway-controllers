              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: rag-specifics\nspec:\n  displayName: rag-specifics\n  version: v1.0\n  context: /rag-specifics\n  provider:\n    id: rag-e2e-provider\n  policies:\n    - name: rag-grounding-guardrail\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            onLowGrounding: block\n            minGroundingScore: 0.0\n            maxUnsupportedSpecifics: 0\n            showAssessment: true\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        }
      ]
