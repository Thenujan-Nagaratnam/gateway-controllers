    {
      "name": "01 - Register",
      "item": [
        {
          "name": "Register provider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-providers",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-providers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProvider\nmetadata:\n  name: rag-e2e-provider\nspec:\n  displayName: RAG E2E Provider\n  version: v1.0\n  template: openai\n  upstream:\n    url: http://host.docker.internal:{{mockPort}}\n  accessControl:\n    mode: allow_all\n"
            }
          }
        },
        {
          "name": "Register rag-block",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: rag-block\nspec:\n  displayName: rag-block\n  version: v1.0\n  context: /rag-block\n  provider:\n    id: rag-e2e-provider\n  policies:\n    - name: rag-grounding-guardrail\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            onLowGrounding: block\n            minGroundingScore: 0.45\n            showAssessment: true\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register rag-warn",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: rag-warn\nspec:\n  displayName: rag-warn\n  version: v1.0\n  context: /rag-warn\n  provider:\n    id: rag-e2e-provider\n  policies:\n    - name: rag-grounding-guardrail\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            onLowGrounding: warn\n  accessControl:\n    mode: allow_all\n"
            }
