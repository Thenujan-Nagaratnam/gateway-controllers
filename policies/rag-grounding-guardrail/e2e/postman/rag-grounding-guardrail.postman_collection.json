                  "const j=pm.response.json();",
                  "pm.test('type',()=>pm.expect(j.type).to.eql('RAG_GROUNDING_GUARDRAIL'));",
                  "pm.test('direction RESPONSE',()=>pm.expect(j.message.direction).to.eql('RESPONSE'));",
                  "pm.test('grounding score reported',()=>pm.expect(j.message.groundingScore).to.be.below(0.45));"
                ]
              }
            }
          ]
        }
      ]
