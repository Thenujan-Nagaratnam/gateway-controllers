            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"gpt-4o\", \"messages\": [{\"role\": \"user\", \"content\": \"Using the passage, answer the question. GROUNDED\"}, {\"role\": \"tool\", \"content\": \"{{passage}}\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200',()=>pm.response.to.have.status(200));",
                  "pm.test('x-grounding-score header',()=>pm.expect(parseFloat(pm.response.headers.get('x-grounding-score'))).to.be.a('number'));"
                ]
              }
            }
          ]
        }
      ]
    },
