            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: rag-cite\nspec:\n  displayName: rag-cite\n  version: v1.0\n  context: /rag-cite\n  provider:\n    id: rag-e2e-provider\n  policies:\n    - name: rag-grounding-guardrail\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            onLowGrounding: block\n            requireCitations: true\n            minGroundingScore: 0.0\n            checkUnsupportedSpecifics: false\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
