    {
      "name": "03 - Deny: refund over ceiling -> 403",
      "item": [
        {
          "name": "issue_refund 9999 -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/opa-block/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "opa-block",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"gpt-4o\", \"params\": {\"name\": \"issue_refund\", \"arguments\": {\"amount\": 9999}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 403',()=>pm.response.to.have.status(403));",
                  "const j=pm.response.json();",
                  "pm.test('type',()=>pm.expect(j.type).to.eql('OPA_AUTHORIZATION'));",
                  "pm.test('direction REQUEST',()=>pm.expect(j.message.direction).to.eql('REQUEST'));",
                  "pm.test('assessments carry opa reason',()=>pm.expect(JSON.stringify(j.message.assessments)).to.include('ceiling'));",
                  "pm.test('generic client message (no raw reason leak)',()=>pm.expect(j.message.actionReason).to.not.include('ceiling'));"
                ]
              }
            }
          ]
        }
      ]
    },
