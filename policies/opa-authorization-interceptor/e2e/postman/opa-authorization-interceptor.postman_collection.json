                ]
              }
            }
          ]
        },
        {
          "name": "backend received redacted ssn",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{mockUrl}}/debug/last",
              "protocol": "http",
              "host": [
                "{{mockUrl}}"
              ],
              "path": [
                "debug",
                "last"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const seen=pm.response.json();",
                  "const args=JSON.parse(seen.body).params.arguments;",
                  "pm.test('ssn redacted before forwarding',()=>pm.expect(args.ssn).to.not.eql('123-45-6789'));",
                  "pm.test('other args intact',()=>pm.expect(args.id).to.eql('x'));",
                  "pm.test('allow-redacted header',()=>pm.expect(seen.headers['x-opa-authz']).to.eql('allow-redacted'));"
                ]
              }
            }
          ]
        }
      ]
