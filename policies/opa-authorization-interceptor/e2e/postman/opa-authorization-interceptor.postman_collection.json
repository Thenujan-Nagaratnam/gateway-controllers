    {
      "name": "10 - Invalid config accepted at registration but the route never enforces",
      "item": [
        {
          "name": "register opa-invalid (no opaUrl)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: opa-invalid\nspec:\n  displayName: opa-invalid\n  version: v1.0\n  context: /opa-invalid\n  provider:\n    id: opa-e2e-provider\n  policies:\n    - name: opa-authorization-interceptor\n      version: v0\n      paths:\n        - path: /mcp\n          methods: [POST]\n          params:\n            decisionPath: \"$.result\"\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration succeeds',()=>pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "opa-invalid route does not enforce",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/opa-invalid/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "opa-invalid",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"gpt-4o\", \"params\": {\"name\": \"issue_refund\", \"arguments\": {\"amount\": 9999}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('misconfigured route: authz not enforced',()=>{",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404,500]);",
                  "  if (pm.response.code===200) pm.expect(pm.response.text()).to.not.include('OPA_AUTHORIZATION');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
