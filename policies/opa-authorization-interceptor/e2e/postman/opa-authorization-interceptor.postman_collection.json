            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: opa-err\nspec:\n  displayName: opa-err\n  version: v1.0\n  context: /opa-err\n  provider:\n    id: opa-e2e-provider\n  policies:\n    - name: opa-authorization-interceptor\n      version: v0\n      paths:\n        - path: /mcp\n          methods: [POST]\n          params:\n            opaUrl: \"http://host.docker.internal:{{mockPort}}/err500\"\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
