    {
      "name": "01 - Register",
      "item": [
        {
          "name": "Register provider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-providers",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-providers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProvider\nmetadata:\n  name: opa-e2e-provider\nspec:\n  displayName: OPA E2E Provider\n  version: v1.0\n  template: openai\n  upstream:\n    url: http://host.docker.internal:{{mockPort}}\n  accessControl:\n    mode: allow_all\n"
            }
          }
        },
        {
          "name": "Register opa-block",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: opa-block\nspec:\n  displayName: opa-block\n  version: v1.0\n  context: /opa-block\n  provider:\n    id: opa-e2e-provider\n  policies:\n    - name: opa-authorization-interceptor\n      version: v0\n      paths:\n        - path: /mcp\n          methods: [POST]\n          params:\n            opaUrl: \"http://host.docker.internal:{{mockPort}}/v1/data/agentgw/authz\"\n            showAssessment: true\n            input:\n              includeHeaders: [\"x-tenant\"]\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register opa-annotate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: opa-annotate\nspec:\n  displayName: opa-annotate\n  version: v1.0\n  context: /opa-annotate\n  provider:\n    id: opa-e2e-provider\n  policies:\n    - name: opa-authorization-interceptor\n      version: v0\n      paths:\n        - path: /mcp\n          methods: [POST]\n          params:\n            opaUrl: \"http://host.docker.internal:{{mockPort}}/v1/data/agentgw/authz\"\n            onDeny: annotate\n            input:\n              includeHeaders: [\"x-tenant\"]\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register opa-failopen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: opa-failopen\nspec:\n  displayName: opa-failopen\n  version: v1.0\n  context: /opa-failopen\n  provider:\n    id: opa-e2e-provider\n  policies:\n    - name: opa-authorization-interceptor\n      version: v0\n      paths:\n        - path: /mcp\n          methods: [POST]\n          params:\n            opaUrl: \"http://host.docker.internal:1/x\"\n            failOpen: true\n            timeoutSeconds: 2\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
