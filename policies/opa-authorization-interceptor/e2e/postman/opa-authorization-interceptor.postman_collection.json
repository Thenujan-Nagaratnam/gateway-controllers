    {
      "name": "02 - Allow: request reaches the backend",
      "item": [
        {
          "name": "reset mock",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://{{mockUrl}}/debug/reset",
              "protocol": "http",
              "host": [
