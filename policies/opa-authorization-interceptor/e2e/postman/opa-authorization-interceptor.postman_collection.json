              "raw": "{\"model\": \"gpt-4o\", \"params\": {\"name\": \"run_sql\", \"arguments\": {\"query\": \"SELECT 1\"}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OPA down + failClosed -> denied',()=>pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
