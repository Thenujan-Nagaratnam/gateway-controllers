            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"flaky-a\", \"arguments\": {}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('500', () => pm.response.to.have.status(500));",
                  "pm.test('still closed', () => pm.expect(pm.response.headers.get('x-circuit-breaker-state')).to.eql('closed'));"
                ]
              }
            }
          ]
        },
        {
          "name": "flaky-a failure #2 -> 500, now open",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/dep-circuit-breaker/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "dep-circuit-breaker",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"flaky-a\", \"arguments\": {}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('500', () => pm.response.to.have.status(500));",
                  "pm.test('open', () => pm.expect(pm.response.headers.get('x-circuit-breaker-state')).to.eql('open'));"
                ]
              }
            }
          ]
        },
        {
          "name": "flaky-a next call is short-circuited -> 503 + Retry-After",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/dep-circuit-breaker/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "dep-circuit-breaker",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"flaky-a\", \"arguments\": {}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('503', () => pm.response.to.have.status(503));",
                  "pm.test('retry-after present', () => pm.expect(pm.response.headers.get('Retry-After')).to.not.be.null);",
                  "const body = pm.response.json();",
                  "pm.test('envelope type', () => pm.expect(body.type).to.eql('DEPENDENCY_CIRCUIT_BREAKER'));",
                  "pm.test('assessments present (showAssessment)', () => pm.expect(body.message.assessments).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
