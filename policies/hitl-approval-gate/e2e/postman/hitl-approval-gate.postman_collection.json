    {
      "name": "07 - Approval is scoped to the exact arguments reviewed",
      "item": [
        {
          "name": "delete_records(id=A) -> 403 pending",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
