                "admin",
                "v1",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('controller up',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "gateway reachable",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('gw',()=>pm.expect(pm.response.code).to.be.oneOf([200,404]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Register",
      "item": [
        {
          "name": "Register provider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-providers",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-providers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProvider\nmetadata:\n  name: hitl-e2e-provider\nspec:\n  displayName: HITL E2E Provider\n  version: v1.0\n  template: openai\n  upstream:\n    url: http://host.docker.internal:{{mockPort}}\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register hitl-gate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: hitl-gate\nspec:\n  displayName: hitl-gate\n  version: v1.0\n  context: /hitl-gate\n  provider:\n    id: hitl-e2e-provider\n  policies:\n    - name: hitl-approval-gate\n      version: v0\n      paths:\n        - path: /mcp\n          methods: [POST]\n          params:\n            highRiskTools: [\"issue_refund\", \"delete_*\"]\n            approverSecret: \"e2e-test-approver-secret-value\"\n            expirySeconds: 60\n            notifyUrl: \"http://host.docker.internal:{{mockPort}}/notify\"\n            includeArguments: true\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register hitl-invalid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: hitl-invalid\nspec:\n  displayName: hitl-invalid\n  version: v1.0\n  context: /hitl-invalid\n  provider:\n    id: hitl-e2e-provider\n  policies:\n    - name: hitl-approval-gate\n      version: v0\n      paths:\n        - path: /mcp\n          methods: [POST]\n          params:\n            highRiskTools: [\"issue_refund\"]\n            approverSecret: \"e2e-test-approver-secret-value\"\n            notifyUrl: \"not-a-valid-url\"\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Low-risk tool calls pass straight through",
      "item": [
        {
          "name": "reset mock",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://{{mockUrl}}/debug/reset",
              "protocol": "http",
              "host": [
                "{{mockUrl}}"
              ],
              "path": [
                "debug",
                "reset"
              ]
            }
          }
        },
        {
          "name": "search -> 200, backend reached",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/hitl-gate/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "hitl-gate",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"method\": \"tools/call\", \"params\": {\"name\": \"search\", \"arguments\": {\"q\": \"weather\"}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "backend was reached",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{mockUrl}}/debug/last-request",
              "protocol": "http",
              "host": [
                "{{mockUrl}}"
              ],
              "path": [
                "debug",
                "last-request"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('backend saw the call',()=>pm.expect(pm.response.json().calls).to.eql(1));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - High-risk call blocks pending approval, backend never reached",
      "item": [
        {
          "name": "reset mock",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://{{mockUrl}}/debug/reset",
              "protocol": "http",
              "host": [
                "{{mockUrl}}"
              ],
              "path": [
                "debug",
                "reset"
              ]
            }
          }
        },
        {
          "name": "issue_refund -> 403 pending",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/hitl-gate/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "hitl-gate",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"method\": \"tools/call\", \"params\": {\"name\": \"issue_refund\", \"arguments\": {\"amount\": 500}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403',()=>pm.response.to.have.status(403));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('approvalId', j.message.approvalId);",
                  "pm.test('type',()=>pm.expect(j.type).to.eql('HITL_APPROVAL_GATE'));",
                  "pm.test('action PENDING_APPROVAL',()=>pm.expect(j.message.action).to.eql('PENDING_APPROVAL'));",
                  "pm.test('approvalId present',()=>pm.expect(j.message.approvalId).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "backend was never reached",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{mockUrl}}/debug/last-request",
              "protocol": "http",
              "host": [
                "{{mockUrl}}"
              ],
              "path": [
                "debug",
                "last-request"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('backend not called',()=>pm.expect(pm.response.json().calls).to.eql(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Decision submission requires the approver secret",
      "item": [
        {
          "name": "wrong secret -> 403 rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-approver-secret",
                "value": "not-the-real-secret"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/hitl-gate/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "hitl-gate",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"approvalDecision\": {\"approvalId\": \"{{approvalId}}\", \"decision\": \"approve\", \"approver\": \"eve\", \"reason\": \"attacker\"}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403',()=>pm.response.to.have.status(403));",
                  "const j=pm.response.json();",
                  "pm.test('action',()=>pm.expect(j.message.action).to.eql('DECISION_REJECTED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "no secret header -> 403 rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/hitl-gate/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "hitl-gate",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"approvalDecision\": {\"approvalId\": \"{{approvalId}}\", \"decision\": \"approve\", \"approver\": \"eve\", \"reason\": \"attacker\"}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403',()=>pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "agent tries approvalId itself as the secret -> 403 rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-approver-secret",
                "value": "{{approvalId}}"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/hitl-gate/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "hitl-gate",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"approvalDecision\": {\"approvalId\": \"{{approvalId}}\", \"decision\": \"approve\", \"approver\": \"attacker\", \"reason\": \"self-approval\"}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403',()=>pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Approve then retry forwards to the backend",
      "item": [
        {
          "name": "approve with the correct secret -> 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-approver-secret",
                "value": "e2e-test-approver-secret-value"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/hitl-gate/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "hitl-gate",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"approvalDecision\": {\"approvalId\": \"{{approvalId}}\", \"decision\": \"approve\", \"approver\": \"alice\", \"reason\": \"looks fine\"}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "pm.test('recorded',()=>pm.expect(j.message.action).to.eql('DECISION_RECORDED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "retry with the approval token -> 200, forwarded",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-approval-token",
                "value": "{{approvalId}}"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/hitl-gate/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "hitl-gate",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"method\": \"tools/call\", \"params\": {\"name\": \"issue_refund\", \"arguments\": {\"amount\": 500}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "backend was reached once, with x-hitl-approved header",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{mockUrl}}/debug/last-request",
              "protocol": "http",
              "host": [
                "{{mockUrl}}"
              ],
              "path": [
                "debug",
                "last-request"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j=pm.response.json();",
                  "pm.test('backend reached',()=>pm.expect(j.calls).to.eql(1));",
                  "pm.test('approved header forwarded upstream',()=>pm.expect(j.headers['x-hitl-approved']).to.eql('true'));"
                ]
              }
            }
          ]
        },
        {
          "name": "retry again with the SAME token -> 403 (single-use, already consumed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-approval-token",
                "value": "{{approvalId}}"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/hitl-gate/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "hitl-gate",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"method\": \"tools/call\", \"params\": {\"name\": \"issue_refund\", \"arguments\": {\"amount\": 500}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403',()=>pm.response.to.have.status(403));",
                  "const j=pm.response.json();",
                  "pm.test('re-prompts as pending',()=>pm.expect(j.message.action).to.eql('PENDING_APPROVAL'));"
                ]
              }
            }
          ]
        }
      ]
    },
