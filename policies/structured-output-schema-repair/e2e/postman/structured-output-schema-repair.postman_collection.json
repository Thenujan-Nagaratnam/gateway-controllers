              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200',()=>pm.response.to.have.status(200));",
                  "pm.test('x-schema-repair: llm',()=>pm.expect(pm.response.headers.get('x-schema-repair')).to.eql('llm'));",
                  "pm.test('repaired to a schema-valid object',()=>{const c=JSON.parse(pm.response.json().choices[0].message.content); pm.expect(c).to.have.property('name'); pm.expect(c).to.have.property('age');});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "10 - Invalid config accepted at registration but the route never enforces",
      "item": [
        {
          "name": "register sosr-invalid (no schema)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: sosr-invalid\nspec:\n  displayName: sosr-invalid\n  version: v1.0\n  context: /sosr-invalid\n  provider:\n    id: sosr-e2e-provider\n  policies:\n    - name: structured-output-schema-repair\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            responseJsonPath: \"$.choices[0].message.content\"\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration succeeds',()=>pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "MISSING_FIELD via sosr-invalid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/sosr-invalid/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "sosr-invalid",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"gpt-4o\", \"messages\": [{\"role\": \"user\", \"content\": \"MISSING_FIELD\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('misconfigured route: repair not enforced',()=>{",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404,500]);",
                  "  if (pm.response.code===200) pm.expect(pm.response.text()).to.not.include('STRUCTURED_OUTPUT_SCHEMA_REPAIR');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
