                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: sosr-block\nspec:\n  displayName: sosr-block\n  version: v1.0\n  context: /sosr-block\n  provider:\n    id: sosr-e2e-provider\n  policies:\n    - name: structured-output-schema-repair\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            schema: \"{\\\"type\\\":\\\"object\\\",\\\"required\\\":[\\\"name\\\",\\\"age\\\"],\\\"properties\\\":{\\\"name\\\":{\\\"type\\\":\\\"string\\\"},\\\"age\\\":{\\\"type\\\":\\\"integer\\\"}},\\\"additionalProperties\\\":false}\"\n            showAssessment: true\n  accessControl:\n    mode: allow_all\n"
            }
