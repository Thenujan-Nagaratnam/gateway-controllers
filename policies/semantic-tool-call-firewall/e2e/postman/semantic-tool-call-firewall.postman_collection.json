    {
      "name": "07 - annotate mode forwards with headers",
      "item": [
        {
          "name": "reset mock",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://{{mockUrl}}/debug/reset",
              "protocol": "http",
              "host": [
                "{{mockUrl}}"
              ],
              "path": [
                "debug",
                "reset"
              ]
            }
          }
        },
        {
          "name": "stcf-annotate: DROP -> 200 forwarded",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/stcf-annotate/call",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "stcf-annotate",
                "call"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"run_sql\", \"arguments\": {\"query\": \"DROP TABLE t\"}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// annotate is a REQUEST-phase action: HeadersToSet adds headers to the",
                  "// UPSTREAM request (verified against the backend below), not to the",
                  "// client-facing response. The call is forwarded, not blocked.",
                  "pm.test('status 200 (annotated, forwarded)',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "backend received the forwarded call",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{mockUrl}}/debug/last-request",
              "protocol": "http",
              "host": [
                "{{mockUrl}}"
              ],
              "path": [
                "debug",
                "last-request"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const seen=pm.response.json();",
                  "pm.test('firewall header reached backend',()=>pm.expect(seen.headers['x-tool-firewall']).to.eql('violation'));",
                  "pm.test('body forwarded',()=>pm.expect(JSON.parse(seen.body).params.name).to.eql('run_sql'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "08 - Invalid config accepted at registration but the route never enforces",
      "item": [
        {
          "name": "register stcf-invalid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: stcf-invalid\nspec:\n  displayName: stcf-invalid\n  version: v1.0\n  context: /stcf-invalid\n  provider:\n    id: stcf-e2e-provider\n  policies:\n    - name: semantic-tool-call-firewall\n      version: v0\n      paths:\n        - path: /call\n          methods: [POST]\n          params:\n            defaultAction: allow\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration succeeds',()=>pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "stcf-invalid route does not enforce",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/stcf-invalid/call",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "stcf-invalid",
                "call"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"run_sql\", \"arguments\": {\"query\": \"DROP TABLE t\"}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('misconfigured route: firewall not enforced',()=>{",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404,500]);",
                  "  if (pm.response.code===200) pm.expect(pm.response.text()).to.not.include('SEMANTIC_TOOL_CALL_FIREWALL');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
