    {
      "name": "04 - Recipient domain allowlist",
      "item": [
        {
          "name": "acme.com -> 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/stcf-email/call",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "stcf-email",
                "call"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"send_email\", \"arguments\": {\"to\": \"bob@acme.com\", \"body\": \"hi\"}}}"
            }
          },
