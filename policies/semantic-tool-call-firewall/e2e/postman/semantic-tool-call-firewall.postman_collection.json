    {
      "name": "01 - Register",
      "item": [
        {
          "name": "Register provider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-providers",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-providers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProvider\nmetadata:\n  name: stcf-e2e-provider\nspec:\n  displayName: STCF E2E Provider\n  version: v1.0\n  template: openai\n  upstream:\n    url: http://host.docker.internal:{{mockPort}}\n  accessControl:\n    mode: allow_all\n"
            }
          }
        },
        {
          "name": "Register stcf-db",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: stcf-db\nspec:\n  displayName: stcf-db\n  version: v1.0\n  context: /stcf-db\n  provider:\n    id: stcf-e2e-provider\n  policies:\n    - name: semantic-tool-call-firewall\n      version: v0\n      paths:\n        - path: /call\n          methods: [POST]\n          params:\n            rules:\n              - toolName: run_sql\n                sql:\n                  allowStatements: [SELECT, WITH]\n                  blockMultipleStatements: true\n                  requireWhereForUpdateDelete: true\n            showAssessment: true\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register stcf-http",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: stcf-http\nspec:\n  displayName: stcf-http\n  version: v1.0\n  context: /stcf-http\n  provider:\n    id: stcf-e2e-provider\n  policies:\n    - name: semantic-tool-call-firewall\n      version: v0\n      paths:\n        - path: /call\n          methods: [POST]\n          params:\n            rules:\n              - toolName: http_request\n                url:\n                  allowedSchemes: [https]\n                  blockPrivateNetworks: true\n                  allowHosts: [api.example.com]\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register stcf-email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: stcf-email\nspec:\n  displayName: stcf-email\n  version: v1.0\n  context: /stcf-email\n  provider:\n    id: stcf-e2e-provider\n  policies:\n    - name: semantic-tool-call-firewall\n      version: v0\n      paths:\n        - path: /call\n          methods: [POST]\n          params:\n            rules:\n              - toolName: send_email\n                recipients:\n                  argPaths: [\"$.to\"]\n                  allowDomains: [acme.com]\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register stcf-refund",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: stcf-refund\nspec:\n  displayName: stcf-refund\n  version: v1.0\n  context: /stcf-refund\n  provider:\n    id: stcf-e2e-provider\n  policies:\n    - name: semantic-tool-call-firewall\n      version: v0\n      paths:\n        - path: /call\n          methods: [POST]\n          params:\n            rules:\n              - toolName: issue_refund\n                numbers:\n                  - argPath: \"$.amount\"\n                    max: 500\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register stcf-deny-default",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: stcf-deny-default\nspec:\n  displayName: stcf-deny-default\n  version: v1.0\n  context: /stcf-deny-default\n  provider:\n    id: stcf-e2e-provider\n  policies:\n    - name: semantic-tool-call-firewall\n      version: v0\n      paths:\n        - path: /call\n          methods: [POST]\n          params:\n            defaultAction: block\n            rules:\n              - toolName: safe_tool\n                strings:\n                  - argPath: \"$.note\"\n                    maxLength: 20\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register stcf-annotate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: stcf-annotate\nspec:\n  displayName: stcf-annotate\n  version: v1.0\n  context: /stcf-annotate\n  provider:\n    id: stcf-e2e-provider\n  policies:\n    - name: semantic-tool-call-firewall\n      version: v0\n      paths:\n        - path: /call\n          methods: [POST]\n          params:\n            onViolation: annotate\n            showAssessment: true\n            rules:\n              - toolName: run_sql\n                sql:\n                  allowStatements: [SELECT]\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
