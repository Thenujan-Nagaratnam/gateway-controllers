    {
      "name": "02 - SQL statement firewall",
      "item": [
        {
          "name": "SELECT allowed -> 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/stcf-db/call",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "stcf-db",
                "call"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"run_sql\", \"arguments\": {\"query\": \"SELECT id FROM users WHERE id = 1\"}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('select allowed',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "DROP TABLE -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/stcf-db/call",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "stcf-db",
                "call"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"run_sql\", \"arguments\": {\"query\": \"DROP TABLE users\"}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('drop blocked',()=>pm.response.to.have.status(422));",
                  "const j=pm.response.json();",
                  "pm.test('type',()=>pm.expect(j.type).to.eql('SEMANTIC_TOOL_CALL_FIREWALL'));",
                  "pm.test('jsonrpc error present',()=>pm.expect(j.jsonrpc).to.eql('2.0') && pm.expect(j.error).to.be.an('object'));",
                  "pm.test('assessments (showAssessment)',()=>pm.expect(j.message.assessments).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "stacked statements -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/stcf-db/call",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "stcf-db",
                "call"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"run_sql\", \"arguments\": {\"query\": \"SELECT 1; DROP TABLE t\"}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('stacked blocked',()=>pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "UPDATE without WHERE -> 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/stcf-db/call",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "stcf-db",
                "call"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"run_sql\", \"arguments\": {\"query\": \"UPDATE users SET admin = true\"}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('update-no-where blocked',()=>pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "UPDATE with WHERE -> still 422 (UPDATE not in allowlist)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/stcf-db/call",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "stcf-db",
                "call"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"run_sql\", \"arguments\": {\"query\": \"UPDATE users SET x=1 WHERE id=1\"}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('update not allowlisted',()=>pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    },
