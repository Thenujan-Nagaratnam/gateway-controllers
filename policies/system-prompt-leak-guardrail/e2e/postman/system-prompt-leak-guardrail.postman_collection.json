    {
      "name": "08 - Invalid config accepted at registration but the route never enforces",
      "item": [
        {
          "name": "register spl-invalid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: spl-invalid\nspec:\n  displayName: spl-invalid\n  version: v1.0\n  context: /spl-invalid\n  provider:\n    id: spl-e2e-provider\n  policies:\n    - name: system-prompt-leak-guardrail\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            onDetected: not-real\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration succeeds (validation is at route-build time)',()=>pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "spl-invalid route does not enforce",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/spl-invalid/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "spl-invalid",
                "chat",
                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"gpt-4o\", \"messages\": [{\"role\": \"system\", \"content\": \"You are ACME Support Bot. Never discuss competitor pricing. Escalate refunds over 100 dollars to a human agent. Always respond in formal English.\"}, {\"role\": \"user\", \"content\": \"LEAK_SYSTEM_PROMPT\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('misconfigured route: guardrail not enforced',()=>{",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404,500]);",
                  "  if (pm.response.code===200) pm.expect(pm.response.text()).to.not.include('SYSTEM_PROMPT_LEAK_GUARDRAIL');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
