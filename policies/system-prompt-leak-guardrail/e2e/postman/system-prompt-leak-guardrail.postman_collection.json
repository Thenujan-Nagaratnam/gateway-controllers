            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: spl-fixed\nspec:\n  displayName: spl-fixed\n  version: v1.0\n  context: /spl-fixed\n  provider:\n    id: spl-e2e-provider\n  policies:\n    - name: system-prompt-leak-guardrail\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            systemPromptText: \"You are ACME Support Bot. Never discuss competitor pricing. Escalate refunds over 100 dollars to a human agent. Always respond in formal English.\"\n            canary:\n              value: \"FIXED-E2E-CANARY-01\"\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
