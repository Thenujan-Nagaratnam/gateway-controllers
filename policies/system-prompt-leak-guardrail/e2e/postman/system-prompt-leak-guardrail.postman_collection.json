            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: spl-redact\nspec:\n  displayName: spl-redact\n  version: v1.0\n  context: /spl-redact\n  provider:\n    id: spl-e2e-provider\n  policies:\n    - name: system-prompt-leak-guardrail\n      version: v0\n      paths:\n        - path: /chat/completions\n          methods: [POST]\n          params:\n            onDetected: redact\n  accessControl:\n    mode: allow_all\n"
