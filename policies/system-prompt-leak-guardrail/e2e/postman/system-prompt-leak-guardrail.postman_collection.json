              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = JSON.parse(pm.response.json().body);",
                  "const sys = b.messages.find(m=>m.role==='system').content;",
                  "pm.test('canary marker appended to system message', () => pm.expect(sys).to.include('<<CONFIDENTIAL:'));"
                ]
              }
            }
          ]
        }
      ]
