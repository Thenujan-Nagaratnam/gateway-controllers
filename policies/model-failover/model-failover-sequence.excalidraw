      "roundness": null,
      "seed": 53710185,
      "version": 1,
      "versionNonce": 1592467582,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788325549937,
      "link": null,
      "locked": false,
      "text": "This diagram walks the provider: \"anthropic\" case below. A bare \"reuse primary\" fallback\n(no provider set) takes the SAME path, just without the x-provider header \u2014 the redial\nfalls straight through to the operation's own default upstream instead of dialing PRIMARY again.",
      "rawText": "This diagram walks the provider: \"anthropic\" case below. A bare \"reuse primary\" fallback\n(no provider set) takes the SAME path, just without the x-provider header \u2014 the redial\nfalls straight through to the operation's own default upstream instead of dialing PRIMARY again.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This diagram walks the provider: \"anthropic\" case below. A bare \"reuse primary\" fallback\n(no provider set) takes the SAME path, just without the x-provider header \u2014 the redial\nfalls straight through to the operation's own default upstream instead of dialing PRIMARY again.",
      "lineHeight": 1.25,
      "baseline": 13
    },
