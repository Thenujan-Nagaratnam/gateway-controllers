      "link": null,
      "locked": false,
      "text": "Every fallback dial is a self-redial (trySelfRedial) \u2014 not just cross-provider ones.",
      "rawText": "Every fallback dial is a self-redial (trySelfRedial) \u2014 not just cross-provider ones.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every fallback dial is a self-redial (trySelfRedial) \u2014 not just cross-provider ones.",
      "lineHeight": 1.25,
      "baseline": 17
    },
    {
      "id": "558847f1e9f74b78",
      "type": "text",
      "x": 40,
      "y": 40,
      "width": 1290,
      "height": 48.75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
