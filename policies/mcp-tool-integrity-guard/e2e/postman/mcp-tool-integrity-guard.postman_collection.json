                "admin",
                "v1",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('controller up',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "gateway reachable",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": []
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('gw',()=>pm.expect(pm.response.code).to.be.oneOf([200,404]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Register",
      "item": [
        {
          "name": "Register provider",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}}/api/management/v1/llm-providers",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-providers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProvider\nmetadata:\n  name: mcpintegrity-e2e-provider\nspec:\n  displayName: MCP Tool Integrity Guard E2E Provider\n  version: v1.0\n  template: openai\n  upstream:\n    url: http://host.docker.internal:{{mockPort}}\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register mcp-integrity-strip",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: mcp-integrity-strip\nspec:\n  displayName: mcp-integrity-strip\n  version: v1.0\n  context: /mcp-integrity-strip\n  provider:\n    id: mcpintegrity-e2e-provider\n  policies:\n    - name: mcp-tool-integrity-guard\n      version: v0\n      paths:\n        - path: /mcp\n          methods: [POST]\n          params:\n            pinnedTools:\n                          search: \"6101ec2d7876d81910d16a728b4b8cba212e88bc652e7a898c2a523b1c5e98b4\"\n                          delete_file: \"b97bfeea1293418e464f5d9e10e6b5ef192fca988477657ab1acb4de0b029414\"\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register mcp-integrity-block",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: mcp-integrity-block\nspec:\n  displayName: mcp-integrity-block\n  version: v1.0\n  context: /mcp-integrity-block\n  provider:\n    id: mcpintegrity-e2e-provider\n  policies:\n    - name: mcp-tool-integrity-guard\n      version: v0\n      paths:\n        - path: /mcp\n          methods: [POST]\n          params:\n            pinnedTools:\n                          search: \"6101ec2d7876d81910d16a728b4b8cba212e88bc652e7a898c2a523b1c5e98b4\"\n                          delete_file: \"b97bfeea1293418e464f5d9e10e6b5ef192fca988477657ab1acb4de0b029414\"\n            onMismatch: block\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register mcp-integrity-annotate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: mcp-integrity-annotate\nspec:\n  displayName: mcp-integrity-annotate\n  version: v1.0\n  context: /mcp-integrity-annotate\n  provider:\n    id: mcpintegrity-e2e-provider\n  policies:\n    - name: mcp-tool-integrity-guard\n      version: v0\n      paths:\n        - path: /mcp\n          methods: [POST]\n          params:\n            pinnedTools:\n                          search: \"6101ec2d7876d81910d16a728b4b8cba212e88bc652e7a898c2a523b1c5e98b4\"\n                          delete_file: \"b97bfeea1293418e464f5d9e10e6b5ef192fca988477657ab1acb4de0b029414\"\n            onMismatch: annotate\n            onUnknownTool: annotate\n            showAssessment: true\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register mcp-integrity-discover",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/yaml"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuthHeader}}"
              }
            ],
            "url": {
              "raw": "http://{{controllerBaseUrl}}}/api/management/v1/llm-proxies",
              "protocol": "http",
              "host": [
                "{{controllerBaseUrl}}"
              ],
              "path": [
                "api",
                "management",
                "v1",
                "llm-proxies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "apiVersion: gateway.api-platform.wso2.com/v1\nkind: LlmProxy\nmetadata:\n  name: mcp-integrity-discover\nspec:\n  displayName: mcp-integrity-discover\n  version: v1.0\n  context: /mcp-integrity-discover\n  provider:\n    id: mcpintegrity-e2e-provider\n  policies:\n    - name: mcp-tool-integrity-guard\n      version: v0\n      paths:\n        - path: /mcp\n          methods: [POST]\n          params:\n            mode: discover\n  accessControl:\n    mode: allow_all\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration accepted (201)', () => pm.expect(pm.response.code).to.eql(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Strip mode: mismatched and unknown tools are removed, matching tool survives",
      "item": [
        {
          "name": "tools/list -> 200, only 'search' survives",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/mcp-integrity-strip/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "mcp-integrity-strip",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/list\", \"params\": {}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const names = body.result.tools.map(t => t.name);",
                  "pm.test('only search survives', () => pm.expect(names).to.eql(['search']));",
                  "pm.test('violation header set', () => pm.expect(pm.response.headers.get('x-mcp-tool-integrity')).to.eql('violation'));"
                ]
              }
            }
          ]
        },
        {
          "name": "tools/call -> 200, non-catalog response untouched",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/mcp-integrity-strip/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "mcp-integrity-strip",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\", \"params\": {\"name\": \"search\", \"arguments\": {\"query\": \"x\"}}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('no integrity header on non-catalog response', () => pm.expect(pm.response.headers.has('x-mcp-tool-integrity')).to.be.false);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Block mode: a hash mismatch fails the whole response",
      "item": [
        {
          "name": "tools/list -> 502 block envelope",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/mcp-integrity-block/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "mcp-integrity-block",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/list\", \"params\": {}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('502', () => pm.response.to.have.status(502));",
                  "const body = pm.response.json();",
                  "pm.test('envelope type', () => pm.expect(body.type).to.eql('MCP_TOOL_INTEGRITY_GUARD'));",
                  "pm.test('names the drifted tool', () => pm.expect(JSON.stringify(body)).to.include('delete_file'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Annotate mode: catalog forwarded unmodified, violations flagged only",
      "item": [
        {
          "name": "tools/list -> 200, all 3 tools present, annotated header set",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/mcp-integrity-annotate/mcp",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "mcp-integrity-annotate",
                "mcp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/list\", \"params\": {}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const names = body.result.tools.map(t => t.name).sort();",
                  "pm.test('all 3 tools still present', () => pm.expect(names).to.eql(['delete_file', 'rogue_tool', 'search']));",
                  "const annotated = pm.response.headers.get('x-mcp-tool-integrity-annotated');",
                  "pm.test('both offenders annotated', () => { pm.expect(annotated).to.include('delete_file'); pm.expect(annotated).to.include('rogue_tool'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Discover mode: never strips or blocks, reports hashes only",
      "item": [
        {
          "name": "tools/list -> 200, catalog unmodified even though nothing is pinned",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/mcp-integrity-discover/mcp",
