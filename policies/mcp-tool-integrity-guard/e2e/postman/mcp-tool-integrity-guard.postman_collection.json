  "item": [
    {
      "name": "00 - Health Checks",
      "item": [
        {
          "name": "mock healthz",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{mockUrl}}/healthz",
              "protocol": "http",
              "host": [
                "{{mockUrl}}"
              ],
              "path": [
                "healthz"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('mock up',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "controller health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{controllerAdminUrl}}/api/admin/v1/health",
              "protocol": "http",
              "host": [
                "{{controllerAdminUrl}}"
              ],
              "path": [
