                "completions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"model\": \"gpt-4o\", \"messages\": [{\"role\": \"user\", \"content\": \"hi\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('misconfigured route: still forwards traffic (never blocking) but is not audited',()=>{",
                  "  pm.expect(pm.response.code).to.be.oneOf([200,404,500]);",
                  "  if (pm.response.code===200) pm.expect(pm.response.headers.has('x-audit-seq')).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
