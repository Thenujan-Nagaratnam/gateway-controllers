      "item": [
        {
          "name": "tal-invalid still forwards but without audit headers",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://{{gatewayBaseUrl}}/tal-invalid/chat/completions",
              "protocol": "https",
              "host": [
                "{{gatewayBaseUrl}}"
              ],
              "path": [
                "tal-invalid",
